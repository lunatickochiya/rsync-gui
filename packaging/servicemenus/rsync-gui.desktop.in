[Desktop Entry]
Type=Service
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=all/allfiles;inode/directory;
X-KDE-Protocols=file,sftp
X-KDE-Submenu=Rsync
X-KDE-Priority=TopLevel
Icon=folder-sync
Actions=rsyncCopy;rsyncCopyPortable;rsyncCopyVerify;rsyncMove;rsyncMovePortable;rsyncMoveVerify;

[Desktop Action rsyncCopy]
Name=复制 (-a)…
Icon=folder-sync
Exec=@RSYNC_GUI_EXECUTABLE@ --preset rsync-copy --browse-destination %U

[Desktop Action rsyncCopyVerify]
Name=复制并校验 (-ac)…
Icon=security-high
Exec=@RSYNC_GUI_EXECUTABLE@ --preset rsync-copy-verify --browse-destination %U

[Desktop Action rsyncCopyPortable]
Name=复制到 FAT/NTFS/NAS (-rlt)…
Icon=drive-removable-media
Exec=@RSYNC_GUI_EXECUTABLE@ --preset rsync-copy-portable --browse-destination %U

[Desktop Action rsyncMove]
Name=移动 (-a)…
Icon=transform-move
Exec=@RSYNC_GUI_EXECUTABLE@ --preset rsync-move --browse-destination %U

[Desktop Action rsyncMoveVerify]
Name=移动并校验 (-ac)…
Icon=security-high
Exec=@RSYNC_GUI_EXECUTABLE@ --preset rsync-move-verify --browse-destination %U

[Desktop Action rsyncMovePortable]
Name=移动到 FAT/NTFS/NAS (-rlt)…
Icon=drive-removable-media
Exec=@RSYNC_GUI_EXECUTABLE@ --preset rsync-move-portable --browse-destination %U
